{
  "name": "bsbi-app-framework",
  "title": "BSBI App Framework",
  "version": "0.1.1",
  "private": true,
  "author": {
    "name": "Tom Humphrey",
    "email": "tom.humphrey@bsbi.org"
  },
  "module": "dist/esm/index.js",
  "type": "module",
  "sideEffects": false,
  "devDependencies": {
    "acorn": "^8.10.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "rollup": "^4.62.2",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-sourcemaps": "^0.6.3",
    "rollup-plugin-string": "^3.0.0",
    "@rollup/plugin-terser": "^1.0.0"
  },
  "dependencies": {
    "localforage": "^1.10.0"
  },
  "peerDependencies": {
    "british-isles-gridrefs": "git+https://github.com/BSBI/js-british-isles-gridrefs.git"
  },
  "scripts": {
    "build": "rollup -c --strictDeprecations",
    "watch": "rollup -c -w --strictDeprecations",
    "audit:rejections": "node scripts/auditPromiseRejections.mjs src",
    "audit:rejections:ci": "node scripts/auditPromiseRejections.mjs src --baseline --strict",
    "audit:imports": "node scripts/auditImports.mjs src",
    "audit:imports:ci": "node scripts/auditImports.mjs src --baseline --strict",
    "audit:ci": "npm run audit:rejections:ci && npm run audit:imports:ci"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BSBI/bsbi-app-framework.git"
  },
  "license": "SEE LICENSE IN readme"
}
